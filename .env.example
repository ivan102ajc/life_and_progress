# Строка подключения к базе Postgres (Neon). На Vercel появляется сама,
# когда вы подключаете базу через вкладку Storage.
DATABASE_URL=

# Секрет для подписи токенов входа. Необязательно: если не задан,
# он вычисляется из DATABASE_URL. Лучше задать любую длинную случайную строку.
AUTH_SECRET=

# Токен Telegram-бота от @BotFather — нужен только для входа из Telegram.
TELEGRAM_BOT_TOKEN=
